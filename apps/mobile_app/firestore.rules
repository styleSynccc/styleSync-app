rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // A user may read and maintain only their own profile.
    match /users/{userId} {
      allow read, create, update, delete: if isSignedInUser(userId);

      // This covers clothes, outfits, outfitPlans, and future user-owned data.
      match /{document=**} {
        allow read, write: if isSignedInUser(userId);
      }
    }
  }
}
